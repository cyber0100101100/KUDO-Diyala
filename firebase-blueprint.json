{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for employees and managers",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["employee", "manager", "admin"] },
        "isVerified": { "type": "boolean" },
        "profileImageUrl": { "type": "string" },
        "jobTitle": { "type": "string" },
        "groupId": { "type": "string" },
        "groupStatus": { "type": "string", "enum": ["none", "pending", "joined"] },
        "shiftStart": { "type": "string" },
        "shiftEnd": { "type": "string" },
        "enrollmentComplete": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Group": {
      "title": "Group",
      "description": "Employee groups managed by managers",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "imageUrl": { "type": "string" },
        "managerId": { "type": "string" },
        "employeeCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "managerId"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance records",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "checkInTime": { "type": "string", "format": "date-time" },
        "checkOutTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["present", "late", "absent"] },
        "location": { "type": "object" },
        "photoUrl": { "type": "string" }
      },
      "required": ["userId", "date", "status"]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "Time off and leave requests",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "startDate", "endDate", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "createdAt"]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "Chat rooms between users",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastUpdate": { "type": "string", "format": "date-time" },
        "unreadCount": { "type": "object" }
      },
      "required": ["participants"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual chat messages",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "text", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "User activity logs including location updates",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "timestamp"]
    },
    "FinancialRecord": {
      "title": "FinancialRecord",
      "description": "Financial records for salary calculations",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "bonus": { "type": "number" },
        "advance": { "type": "number" },
        "deduction": { "type": "number" },
        "overtime": { "type": "number" },
        "period": { "type": "string", "description": "YYYY-MM format" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["userId", "period", "createdAt"]
    },
    "ShiftSchedule": {
      "title": "ShiftSchedule",
      "description": "Planned work shifts for employees",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "startTime": { "type": "string", "description": "HH:mm format" },
        "endTime": { "type": "string", "description": "HH:mm format" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "notificationsSent": { "type": "object" }
      },
      "required": ["userId", "date", "startTime", "endTime", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Attendance records"
    },
    "/requests/{requestId}": {
      "schema": "LeaveRequest",
      "description": "Leave requests"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/chats/{chatId}": {
      "schema": "ChatRoom",
      "description": "Chat rooms"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Chat messages"
    },
    "/groups/{groupId}": {
      "schema": "Group",
      "description": "Employee groups"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Activity and location logs"
    },
    "/financial_records/{recordId}": {
      "schema": "FinancialRecord",
      "description": "Financial records for salary"
    },
    "/schedules/{scheduleId}": {
      "schema": "ShiftSchedule",
      "description": "Planned shifts"
    }
  }
}
